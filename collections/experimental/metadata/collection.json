{
  "schemaVersion": 1,
  "name": "Aster Experimental",
  "slug": "experimental",
  "status": "experimental",
  "description": "A disposable collection used to prove Aster's source-to-package workflow.",
  "licence": "CC-BY-4.0",
  "attribution": "Aster contributors",
  "allowIconLicenceOverride": false,
  "defaultSize": 24,
  "minimumSize": 16,
  "presentationDefaults": {
    "fill": "none",
    "stroke": "currentColor",
    "strokeWidth": 1
  },
  "presentationOverrides": [
    "stroke",
    "strokeWidth"
  ],
  "validation": {
    "viewBox": {
      "expected": {
        "minX": 0,
        "minY": 0,
        "width": 24,
        "height": 24
      },
      "severity": "warning"
    },
    "stroke": {
      "acceptedWidths": [
        1
      ],
      "severity": "warning"
    },
    "grid": {
      "step": 0.5,
      "severity": "warning"
    },
    "bounds": {
      "inset": [
        2,
        2,
        2,
        2
      ],
      "severity": "warning"
    },
    "complexity": {
      "maxPrimitives": 4,
      "maxPathCommands": 12,
      "severity": "warning"
    }
  }
}
