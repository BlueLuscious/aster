{
  "name": "@aster/import",
  "version": "0.0.0",
  "description": "Private host-independent icon adoption compiler for Aster.",
  "private": true,
  "type": "module",
  "author": "BlueLuscious",
  "license": "ISC",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "pnpm run clean && tsc -p tsconfig.json",
    "check:types": "tsc -p tsconfig.json --noEmit",
    "clean": "node ../../tooling/workspace/clean-package-output.mjs dist",
    "test": "pnpm run test:types && pnpm run test:runtime && pnpm run test:abi",
    "test:abi": "pnpm run build && node --test --test-isolation=none tests/abi/*.test.mjs",
    "test:runtime": "tsx --test --test-isolation=none tests/runtime/*.test.ts",
    "test:types": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@aster/core": "workspace:*",
    "xmlsax-typescript": "1.0.0"
  }
}
