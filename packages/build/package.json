{
  "name": "@aster/build",
  "version": "0.0.0",
  "description": "Private build-time SVG ingestion and generation domain services for Aster.",
  "private": true,
  "type": "module",
  "author": "BlueLuscious",
  "license": "ISC",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "pnpm run clean && tsc -p tsconfig.json",
    "check:types": "tsc -p tsconfig.json --noEmit",
    "clean": "node ../../tooling/workspace/clean-package-output.mjs dist",
    "test": "pnpm run test:types && pnpm run test:runtime",
    "test:runtime": "tsx --test --test-isolation=none tests/runtime/*.test.ts",
    "test:types": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "xmlsax-typescript": "1.0.0"
  }
}
