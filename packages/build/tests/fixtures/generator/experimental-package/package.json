{
  "name": "@aster/experimental",
  "version": "0.0.0",
  "description": "Experimental portable icon definitions for Aster.",
  "type": "module",
  "license": "CC-BY-4.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./frame": {
      "import": "./dist/icons/frame.js",
      "types": "./dist/icons/frame.d.ts"
    },
    "./manifest": {
      "import": "./dist/manifest.js",
      "types": "./dist/manifest.d.ts"
    },
    "./orbit": {
      "import": "./dist/icons/orbit.js",
      "types": "./dist/icons/orbit.d.ts"
    },
    "./spark": {
      "import": "./dist/icons/spark.js",
      "types": "./dist/icons/spark.d.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm run clean && tsc -p tsconfig.json",
    "check:types": "tsc -p tsconfig.json --noEmit",
    "clean": "node ../../tooling/workspace/clean-package-output.mjs dist"
  },
  "dependencies": {
    "@aster/core": "workspace:*"
  },
  "aster": {
    "generatedBy": "@aster/build",
    "schemaVersion": 1,
    "sources": [
      "collections/experimental/metadata/collection.json",
      "collections/experimental/metadata/frame.json",
      "collections/experimental/metadata/orbit.json",
      "collections/experimental/metadata/spark.json",
      "collections/experimental/svg/frame.svg",
      "collections/experimental/svg/orbit.svg",
      "collections/experimental/svg/spark.svg"
    ],
    "rebuild": "pnpm aster:build",
    "editingPolicy": "generated"
  }
}
