{
  "name": "@aster/svg",
  "version": "0.0.0",
  "description": "Framework-independent SVG rendering for portable Aster icon definitions.",
  "type": "module",
  "author": "BlueLuscious",
  "license": "ISC",
  "homepage": "https://github.com/BlueLuscious/aster/tree/develop/packages/svg#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BlueLuscious/aster.git",
    "directory": "packages/svg"
  },
  "bugs": {
    "url": "https://github.com/BlueLuscious/aster/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm run clean && tsc -p tsconfig.json",
    "check:types": "tsc -p tsconfig.json --noEmit",
    "clean": "node ../../tooling/workspace/clean-package-output.mjs dist",
    "test": "pnpm run test:types && pnpm run test:runtime && pnpm run test:abi",
    "test:abi": "pnpm run build && node --test --test-isolation=none tests/abi/*.test.mjs",
    "test:runtime": "tsx --test --test-isolation=none tests/runtime/*.test.ts",
    "test:types": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@aster/core": "workspace:*"
  },
  "devDependencies": {
    "@aster/icons": "workspace:*"
  }
}
