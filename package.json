{
  "name": "aster",
  "description": "Framework-agnostic icon definitions, curated collections, and rendering adapters.",
  "private": true,
  "type": "module",
  "author": "BlueLuscious",
  "license": "ISC",
  "homepage": "https://github.com/BlueLuscious/aster#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BlueLuscious/aster.git"
  },
  "bugs": {
    "url": "https://github.com/BlueLuscious/aster/issues"
  },
  "engines": {
    "node": ">=24.10.0 <25"
  },
  "packageManager": "pnpm@10.28.1",
  "workspaces": [
    "packages/*"
  ],
  "keywords": [
    "icons",
    "svg",
    "typescript",
    "framework-agnostic"
  ],
  "scripts": {
    "build": "pnpm --recursive --if-present run build",
    "check": "pnpm run check:types && pnpm run lint && pnpm run format:check",
    "check:types": "pnpm --recursive --if-present run check:types",
    "clean": "pnpm --recursive --if-present run clean",
    "format": "pnpm --recursive --if-present run format",
    "format:check": "pnpm --recursive --if-present run format:check",
    "lint": "pnpm --recursive --if-present run lint",
    "test": "pnpm --recursive --if-present run test",
    "verify": "pnpm run check && pnpm run test && pnpm run build"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "tsx": "4.23.1",
    "typescript": "5.9.3"
  }
}
